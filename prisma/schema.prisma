generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  watchlist WatchlistItem[]
}

// TMDB is the source of truth for the movie itself — title/poster are
// denormalized here just so the watchlist page can render without an extra
// TMDB call (and stays intact even if TMDB removes the title later).
model WatchlistItem {
  id         String   @id @default(cuid())
  userId     String
  movieId    Int
  title      String
  posterPath String?
  // Denormalized alongside title/poster, for the same reason — also lets
  // recommendations be computed from the watchlist without re-fetching
  // every title from TMDB just to know its genres.
  genreIds   Int[]
  rating     Int?
  addedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}
